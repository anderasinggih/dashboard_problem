<!-- 
  =============================================================================
  HUAWEI OWS - PARTY MANAGEMENT CONFIGURATION PAGE (STANDALONE PAGE)
  =============================================================================
  100% OWS Sanitizer Proof: No <button> or <label> tags in raw HTML.
  All buttons, labels, and forms are generated programmatically in custom_dashboard_script.js.
-->
<div class="custom-dashboard-wrapper" style="min-height: 100vh; background-color: #09090b; color: #e4e4e7;">
  <!-- Header Bar -->
  <div class="custom-dashboard-header">
    <div class="custom-header-info">
      <h1 class="custom-header-title">PARTY MANAGEMENT CONFIGURATION</h1>
      <p class="custom-header-subtitle" id="liveTickerClock">Daftarkan Party resmi enterprise. Party yang belum terdaftar otomatis dikelompokkan ke OTHERS.</p>
    </div>
  </div>

  <div class="custom-config-container">
    <div class="custom-config-grid">
      <!-- Card 1: Daftar Party Resmi Aktif -->
      <div class="custom-config-card">
        <div class="custom-config-header">
          <span>Daftar Party Resmi Terdaftar</span>
          <span class="custom-badge custom-bg-success" id="activePartiesCount">0 Registered</span>
        </div>
        <div class="custom-config-body">
          <!-- Tag List Kontainer (Injected via JS) -->
          <div class="custom-party-tag-list" id="registeredPartiesTagList">
            <div style="color: #a1a1aa; font-size: 13px;">Memuat daftar party...</div>
          </div>

          <!-- Label & Form Kontainer (Injected via JS) -->
          <div style="margin-top: 16px; border-top: 1px solid #27272a; padding-top: 16px;" id="addPartyFormSection">
            <div style="color: #a1a1aa; font-size: 13px;">Memuat form...</div>
          </div>
        </div>
      </div>

      <!-- Card 2: Auto-Detected Parties dari Database OWS -->
      <div class="custom-config-card">
        <div class="custom-config-header">
          <span>Auto-Detected Responsibility dari OWS DB</span>
          <div id="scanBtnContainer"></div>
        </div>
        <div class="custom-config-body" style="padding: 0;">
          <div id="autoDetectPartiesContainer">
            <div style="color: #a1a1aa; padding: 16px; font-size: 13px;">Memindai responsibility di database...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
