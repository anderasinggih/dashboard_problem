<div class="custom-dashboard-wrapper">
  <!-- Page View 1: Main Dashboard -->
  <div id="pageDashboardView" class="custom-page-view">
    <!-- Header Bar -->
    <div class="custom-dashboard-header">
      <div class="custom-header-info">
        <h1 class="custom-header-title">PROBLEM MANAGEMENT DASHBOARD</h1>
        <p class="custom-header-subtitle" id="liveTickerClock">Real-time enterprise monitoring & SLA tracking</p>
      </div>
      <div id="customHeaderControlsPlaceholder"></div>
    </div>

    <!-- Date Filter Container Placeholder (Injected via JS) -->
    <div id="customFilterContainer"></div>

    <!-- 1. STATISTIC CARDS — Single row grid (5 cards) -->
    <div class="custom-stat-card-grid">
      <!-- Card: Total PT -->
      <div class="custom-stat-card">
        <div class="custom-stat-right">
          <div class="custom-stat-title">TOTAL PT</div>
          <div class="custom-stat-number" id="statTotal">0</div>
        </div>
      </div>

      <!-- Card: Open PT -->
      <div class="custom-stat-card">
        <div class="custom-stat-right">
          <div class="custom-stat-title">OPEN PT</div>
          <div class="custom-stat-number custom-text-danger" id="statOpen">0</div>
        </div>
      </div>

      <!-- Card: Pending PT -->
      <div class="custom-stat-card">
        <div class="custom-stat-right">
          <div class="custom-stat-title">PENDING PT</div>
          <div class="custom-stat-number custom-text-warning" id="statInProgress">0</div>
        </div>
      </div>

      <!-- Card: Closed PT -->
      <div class="custom-stat-card">
        <div class="custom-stat-right">
          <div class="custom-stat-title">CLOSED PT</div>
          <div class="custom-stat-number custom-text-success" id="statClosed">0</div>
        </div>
      </div>

      <!-- Card: Paused PT -->
      <div class="custom-stat-card">
        <div class="custom-stat-right">
          <div class="custom-stat-title">PAUSED PT</div>
          <div class="custom-stat-number custom-val-paused" id="statPaused">0</div>
        </div>
      </div>
    </div>

    <!-- 2. DYNAMIC PARTNER CARDS CONTAINER (Injected via JS based on PartyManager) -->
    <div class="custom-card-grid" id="partnerCardsContainer">
      <div class="custom-state-notice">Loading party data...</div>
    </div>

    <!-- 1. SEVERITY OVERVIEW (SLA BASED) -->
    <div class="custom-panel-card" style="margin-bottom: 14px;">
      <div class="custom-panel-header" style="padding: 10px 14px;">
        <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">1. SEVERITY OVERVIEW (SLA BASED)</span>
      </div>
      <div class="custom-panel-body" style="padding: 12px;">
        <div class="custom-severity-grid">
          <!-- EMERGENCY CARD -->
          <div class="custom-severity-card custom-border-emergency">
            <div class="custom-severity-title custom-text-emergency">EMERGENCY (SLA : 7 Days)</div>
            <div class="custom-severity-chart-row">
              <div class="custom-chart-container" id="chartEmergency"></div>
              <div class="custom-legend-container" id="legendEmergency"></div>
            </div>
            <table class="custom-severity-table">
              <thead>
                <tr>
                  <th>Total PT</th>
                  <th>Pending PT</th>
                  <th>Closed PT</th>
                  <th>WITHIN SLA</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td id="emergencyTotal">0</td>
                  <td id="emergencyPending">0</td>
                  <td id="emergencyClosed" class="custom-text-success">0</td>
                  <td id="emergencyWithin" class="custom-text-success">0</td>
                </tr>
              </tbody>
            </table>
            <div class="custom-severity-footer custom-bg-emergency">SLA Time : 7 Days</div>
          </div>

          <!-- CRITICAL CARD -->
          <div class="custom-severity-card custom-border-critical">
            <div class="custom-severity-title custom-text-critical">CRITICAL (SLA : 15 Days)</div>
            <div class="custom-severity-chart-row">
              <div class="custom-chart-container" id="chartCritical"></div>
              <div class="custom-legend-container" id="legendCritical"></div>
            </div>
            <table class="custom-severity-table">
              <thead>
                <tr>
                  <th>Total PT</th>
                  <th>Pending PT</th>
                  <th>Closed PT</th>
                  <th>WITHIN SLA</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td id="criticalTotal">0</td>
                  <td id="criticalPending">0</td>
                  <td id="criticalClosed" class="custom-text-success">0</td>
                  <td id="criticalWithin" class="custom-text-success">0</td>
                </tr>
              </tbody>
            </table>
            <div class="custom-severity-footer custom-bg-critical">SLA Time : 15 Days</div>
          </div>

          <!-- MAJOR CARD -->
          <div class="custom-severity-card custom-border-major">
            <div class="custom-severity-title custom-text-major">MAJOR (SLA : 21 Days)</div>
            <div class="custom-severity-chart-row">
              <div class="custom-chart-container" id="chartMajor"></div>
              <div class="custom-legend-container" id="legendMajor"></div>
            </div>
            <table class="custom-severity-table">
              <thead>
                <tr>
                  <th>Total PT</th>
                  <th>Pending PT</th>
                  <th>Closed PT</th>
                  <th>WITHIN SLA</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td id="majorTotal">0</td>
                  <td id="majorPending">0</td>
                  <td id="majorClosed" class="custom-text-success">0</td>
                  <td id="majorWithin" class="custom-text-success">0</td>
                </tr>
              </tbody>
            </table>
            <div class="custom-severity-footer custom-bg-major">SLA Time : 21 Days</div>
          </div>

          <!-- MINOR CARD -->
          <div class="custom-severity-card custom-border-minor">
            <div class="custom-severity-title custom-text-minor">MINOR (SLA : 30 Days)</div>
            <div class="custom-severity-chart-row">
              <div class="custom-chart-container" id="chartMinor"></div>
              <div class="custom-legend-container" id="legendMinor"></div>
            </div>
            <table class="custom-severity-table">
              <thead>
                <tr>
                  <th>Total PT</th>
                  <th>Pending PT</th>
                  <th>Closed PT</th>
                  <th>WITHIN SLA</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td id="minorTotal">0</td>
                  <td id="minorPending">0</td>
                  <td id="minorClosed" class="custom-text-success">0</td>
                  <td id="minorWithin" class="custom-text-success">0</td>
                </tr>
              </tbody>
            </table>
            <div class="custom-severity-footer custom-bg-minor">SLA Time : 30 Days</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. PHASE STATUS BY RESPONSIBILITY PARTY -->
    <div class="custom-panel-card" style="margin-bottom: 14px;">
      <div class="custom-panel-header" style="padding: 10px 14px;">
        <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">2. PHASE STATUS BY RESPONSIBILITY PARTY</span>
      </div>
      <div class="custom-panel-body" style="padding: 12px;">
        <!-- Row 1: OVERALL SUMMARY (Contained Card) -->
        <div class="custom-phase-overall-card" style="margin-bottom: 12px;">
          <div class="custom-phase-col-header" style="text-align: left; padding: 8px 14px; justify-content: flex-start;">
            <span style="font-weight: 600; font-size: 12px; text-transform: uppercase; color: #f4f4f5; letter-spacing: 0.03em;">OVERALL SUMMARY</span>
          </div>
          <div class="custom-phase-table-wrapper" id="tablePhaseOverall">
            <div class="custom-state-notice">Loading summary data...</div>
          </div>
        </div>

        <!-- Row 2: PARTNERS (Dynamically rendered via JS based on PartyManager) -->
        <div class="custom-phase-grid" id="phasePartnersGrid">
          <div class="custom-state-notice">Loading partner phase data...</div>
        </div>
      </div>
    </div>

    <!-- 3. WEEKLY TREND ROW -->
    <div class="custom-panel-card" style="margin-bottom: 14px;">
      <div class="custom-panel-header" id="weeklyTrendHeader" style="display: flex !important; justify-content: space-between !important; align-items: center !important; flex-wrap: wrap !important; gap: 12px !important; padding: 10px 14px !important;">
        <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">3. WEEKLY TREND (CREATED PT)</span>
        <div id="weeklyTrendControlsPlaceholder" style="margin-left: auto; display: flex; align-items: center; gap: 10px;"></div>
      </div>
      <div class="custom-panel-body" style="padding: 10px; overflow-x: auto;">
        <div id="chartWeeklyTrend" style="width: 100%; min-width: 1200px; height: 480px;"></div>
      </div>
    </div>

    <!-- 4. TRENDS & SLA COMPLIANCE PANEL ROW -->
    <div class="custom-trends-row" style="margin-bottom: 14px; margin-top: 0; gap: 12px;">
      <!-- TOP ROOT CAUSE -->
      <div class="custom-panel-card custom-rootcause-card" style="flex: 1; margin-bottom: 0;">
        <div class="custom-panel-header" style="padding: 10px 14px;">
          <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">4. TOP ROOT CAUSE (ALL PT)</span>
        </div>
        <div class="custom-panel-body" style="padding: 12px;">
          <div id="chartTopRootCause" style="width: 100%; height: 320px;"></div>
        </div>
      </div>

      <!-- SLA COMPLIANCE BY PARTY -->
      <div class="custom-panel-card custom-compliance-card" style="flex: 1; margin-bottom: 0;">
        <div class="custom-panel-header" style="padding: 10px 14px;">
          <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">5. AGING PT VS SLA COMPLIANCE</span>
        </div>
        <div class="custom-panel-body" style="padding: 8px; overflow-x: auto;">
          <div id="tableSlaCompliance">
            <div class="custom-state-notice">Loading compliance data...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. SLA PAUSE REASON CARD -->
    <div class="custom-panel-card" style="margin-bottom: 14px;">
      <div class="custom-panel-header" style="padding: 10px 14px;">
        <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">6. SLA PAUSE REASON</span>
      </div>
      <div class="custom-panel-body" style="padding: 10px;">
        <div id="slaPauseReasonContainer">
          <div class="custom-state-notice">Loading SLA pause reasons...</div>
        </div>
      </div>
    </div>

    <!-- 7. MAIN LIST PANEL (Problem Ticket List) -->
    <div class="custom-panel-card" style="margin-bottom: 0;">
      <div class="custom-panel-header" style="padding: 10px 14px;">
        <span style="font-size: 13px; font-weight: 700; color: #f4f4f5; text-transform: uppercase; letter-spacing: 0.02em;">7. PROBLEM TICKET LIST</span>
      </div>
      <div class="custom-panel-body">
        <div id="ticketSearchContainer"></div>
        <div id="ticketContainer">
          <div class="custom-state-notice">Loading ticket data...</div>
        </div>
      </div>
    </div>
  </div> <!-- End #pageDashboardView -->
</div> <!-- End .custom-dashboard-wrapper -->