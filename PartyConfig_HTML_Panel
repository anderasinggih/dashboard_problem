<!-- 
  =============================================================================
  HUAWEI OWS - PARTY MANAGEMENT CONFIGURATION PAGE
  =============================================================================
  Clean 2-Table Enterprise Layout:
  Left: Available Vendors
  Right: Selected Vendors
-->
<div class="custom-dashboard-wrapper" style="min-height: 100vh; background-color: #09090b; color: #e4e4e7;">
  <!-- Header Bar -->
  <div class="custom-dashboard-header">
    <div class="custom-header-info">
      <h1 class="custom-header-title">PARTY MANAGEMENT CONFIGURATION</h1>
      <p class="custom-header-subtitle" id="liveTickerClock">Configure enterprise responsibility parties. Unselected vendors are automatically categorized under OTHERS.</p>
    </div>
  </div>

  <div class="custom-config-container">
    <div class="custom-config-grid">
      <!-- Left Table: Available Vendors -->
      <div class="custom-config-card">
        <div class="custom-config-header">
          <span>Available Vendors</span>
        </div>
        <div class="custom-config-body" style="padding: 0;">
          <div id="autoDetectPartiesContainer">
            <div style="color: #71717a; padding: 20px; text-align: center; font-size: 12px;">Loading available vendors...</div>
          </div>
        </div>
      </div>

      <!-- Right Table: Selected Vendors -->
      <div class="custom-config-card">
        <div class="custom-config-header">
          <span>Selected Vendors</span>
          <span class="custom-badge custom-bg-success" id="activePartiesCount">0 Selected</span>
        </div>
        <div class="custom-config-body" style="padding: 0;">
          <div id="registeredPartiesTagList">
            <div style="color: #71717a; padding: 20px; text-align: center; font-size: 12px;">Loading selected vendors...</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
